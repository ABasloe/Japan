rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function trip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function isOwner(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && trip(tripId).data.ownerUid == request.auth.uid;
    }

    function isMember(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    match /trips/{tripId} {
      // The first signed-in organizer claims an empty shared trip. Thereafter
      // only its owner may alter this root document.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // This root record only contains the owner ID and title. Signed-in
      // visitors may read it to learn whether they should request access;
      // the itinerary, activity feed, and member list remain member-only.
      allow get: if signedIn();
      allow list: if false;
      allow update, delete: if isOwner(tripId);

      match /members/{memberId} {
        // A signed-in visitor may check only their own membership document so
        // the page can distinguish "not yet approved" from an access error.
        allow get: if isOwner(tripId)
          || (signedIn() && memberId == request.auth.uid);
        allow list: if isOwner(tripId);
        allow create, update, delete: if isOwner(tripId);
      }

      match /accessRequests/{requestId} {
        allow create: if signedIn()
          && requestId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow get: if isOwner(tripId) || requestId == request.auth.uid;
        allow list: if isOwner(tripId);
        allow update, delete: if isOwner(tripId);
      }

      match /stops/{stopId} {
        allow read, create, update, delete: if isMember(tripId);
      }

      match /activity/{activityId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId);
        allow update, delete: if false;
      }
    }
  }
}
